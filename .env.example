# ------------------------------------------------------------------------------
# This is an example .env file.
#
# All of these environment vars must be defined either in your environment or in
# a local .env file in order to run this app.
#
# @see https://github.com/rolodato/dotenv-safe for more details.
# ------------------------------------------------------------------------------

# Optional (for fathom analytics)
#NEXT_PUBLIC_FATHOM_ID=

# Optional (for PostHog analytics)
#NEXT_PUBLIC_POSTHOG_ID=

# Optional (for rendering tweets more efficiently)
#TWITTER_ACCESS_TOKEN=

# Optional (for persisting preview images to redis)
# NOTE: if you want to enable redis, only REDIS_HOST and REDIS_PASSWORD are required
# NOTE: don't forget to set isRedisEnabled to true in the site.config.ts file
#REDIS_HOST=
#REDIS_PASSWORD=
#REDIS_USER='default'
#REDIS_NAMESPACE='preview-images'

# ------------------------------------------------------------------------------
# Aszófő booking pages (/aszofo). See src/aszofo/README.md.
# ------------------------------------------------------------------------------

# Upstash Redis (Vercel Marketplace sets these). Without them, `pnpm dev` keeps
# data in .data/aszofo-dev.json; production refuses requests until they're set.
#KV_REST_API_URL=
#KV_REST_API_TOKEN=

# Signs the host session cookie. Any long random string.
#ASZOFO_SECRET=

# Resend, for request/approval emails and the host sign-in link.
#RESEND_API_KEY=
#ASZOFO_EMAIL_FROM="Aszófő <haz@hejj.xyz>"

# Who may sign in to /aszofo/admin, as "Name <email>" separated by commas.
# They all get notices about new requests and decisions. Defaults to
# ASZOFO_ADMIN_EMAIL, then andras@hejj.xyz.
#ASZOFO_HOSTS="Andras <andras@hejj.xyz>, Second Host <second@example.com>"

# Optional: private house details used until a host saves them in the
# dashboard (JSON with any of address, mapsUrl, lat, lng, parking, keyPhone,
# keyPickup, arrival, whatsapp, notes).
#ASZOFO_HOUSE='{"mapsUrl":"https://maps.app.goo.gl/…","lat":"46.9","lng":"17.8"}'

# Optional: a sign-in password fallback, a different notice list, and the
# public origin used in emailed links.
#ASZOFO_ADMIN_PASSWORD=
#ASZOFO_NOTIFY=andras@hejj.xyz,second@example.com
#ASZOFO_BASE_URL=https://www.andrashejj.com
