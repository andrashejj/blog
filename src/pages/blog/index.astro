---
import PostCard from "../../components/PostCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getAllPostMeta } from "../../lib/content";
import { seriesRegistry } from "../../lib/site";

const posts = await getAllPostMeta();

// Build the filter bar from whatever series actually appear in the archive,
// keeping registry order. Each chip filters the grid client-side.
const presentSeries = Object.entries(seriesRegistry)
  .filter(([id]) => posts.some((post) => post.series === id))
  .map(([id, meta]) => ({
    id,
    label: meta.label,
    count: posts.filter((post) => post.series === id).length,
  }));
---

<SiteLayout title='Blog' path='/blog'>
  <section class='reveal reveal-2'>
    <p class='font-mono text-[0.8rem] font-bold uppercase tracking-[0.16em] text-pine'>Writing · {posts.length} posts</p>
    <h1
      class='mt-2 font-display leading-[0.95] tracking-[-0.04em] text-ink'
      style='font-size: clamp(2.8rem, 7.4vw, 5.6rem); font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144; font-weight: 800;'
    >
      Everything I've <span class='italic text-terracotta'>written.</span>
    </h1>
    <p class='mt-5 max-w-[52ch] text-xl leading-relaxed text-ink-soft'>
      Newest first. Some posts are technical, some are personal, and plenty sit awkwardly
      between the two.
    </p>
  </section>

  {presentSeries.length > 0 && (
    <section class='reveal reveal-3 mt-8' data-series-filter>
      <div class='flex flex-wrap items-center gap-2 font-mono text-[0.76rem] font-bold uppercase tracking-[0.08em]'>
        <button
          type='button'
          data-filter='all'
          aria-pressed='true'
          class='series-chip is-active no-rule rounded-full border-2 border-ink px-3.5 py-1.5 text-ink transition'
        >
          All <span class='opacity-60'>({posts.length})</span>
        </button>
        {presentSeries.map((s) => (
          <button
            type='button'
            data-filter={s.id}
            aria-pressed='false'
            class='series-chip no-rule rounded-full border-2 border-ink px-3.5 py-1.5 text-ink transition'
          >
            {s.label} <span class='opacity-60'>({s.count})</span>
          </button>
        ))}
      </div>
    </section>
  )}

  <section
    class='reveal reveal-3 mt-12 grid grid-cols-[repeat(auto-fit,minmax(290px,1fr))] gap-x-8 gap-y-14'
    data-post-grid
  >
    {posts.map((post, i) => (
      <div
        class={`reveal reveal-${Math.min(6, (i % 5) + 2)}`}
        data-series={post.series ?? ""}
      >
        <PostCard post={post} />
      </div>
    ))}
  </section>

  <p
    class='mt-12 font-mono text-[0.72rem] uppercase tracking-[0.22em] text-muted'
    data-empty-state
    hidden
  >
    No posts in this series yet.
  </p>

  <style>
    .series-chip.is-active {
      background: var(--color-ink, #1b1713);
      color: var(--color-paper, #f7f1e4);
      border-color: var(--color-ink, #1b1713);
    }
        .series-chip:not(.is-active):hover {
      background: rgba(23, 24, 28, 0.08);
    }
  </style>

  <script is:inline>
    (() => {
      const root = document.querySelector("[data-series-filter]");
      const grid = document.querySelector("[data-post-grid]");
      if (!root || !grid) return;

      const chips = Array.from(root.querySelectorAll(".series-chip"));
      const cards = Array.from(grid.querySelectorAll("[data-series]"));
      const empty = document.querySelector("[data-empty-state]");

      function apply(filter) {
        let shown = 0;
        for (const card of cards) {
          const match = filter === "all" || card.dataset.series === filter;
          card.hidden = !match;
          if (match) shown++;
        }
        for (const chip of chips) {
          const active = chip.dataset.filter === filter;
          chip.classList.toggle("is-active", active);
          chip.setAttribute("aria-pressed", String(active));
        }
        if (empty) empty.hidden = shown !== 0;
      }

      for (const chip of chips) {
        chip.addEventListener("click", () => {
          const filter = chip.dataset.filter || "all";
          apply(filter);
          const url = new URL(window.location.href);
          if (filter === "all") url.searchParams.delete("series");
          else url.searchParams.set("series", filter);
          history.replaceState(null, "", url);
        });
      }

      const initial = new URL(window.location.href).searchParams.get("series");
      if (initial && chips.some((c) => c.dataset.filter === initial)) {
        apply(initial);
      }
    })();
  </script>
</SiteLayout>
