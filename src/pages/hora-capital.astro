---
import { ArrowUpRight } from "@lucide/astro";
import { site } from "../lib/site";
import "../styles/hora-capital.css";

const canonical = new URL("/hora-capital", site.url).href;
const mission =
  "We back founders with patient capital and practical support, giving good ideas the time to become businesses that improve how we live and work.";
const socialImage = new URL("/images/hora-capital/hour-flower.webp", site.url)
  .href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hora Capital</title>
    <meta name="description" content={mission} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ede8df" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/images/hora-capital/mark.svg" />
    <link rel="preload" href="/fonts/Fraunces-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Fraunces-Italic.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/algernon/DMSans-Latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/images/hora-capital/hour-flower.webp" as="image" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hora Capital" />
    <meta property="og:title" content="Hora Capital | Capital that gives you time" />
    <meta property="og:description" content={mission} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="An ivory flower within a sculptural bronze hour dial, in warm afternoon light." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hora Capital | Capital that gives you time" />
    <meta name="twitter:description" content={mission} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scene">
      <img class="scene-art" src="/images/hora-capital/hour-flower.webp" alt="An ivory flower growing inside a fine bronze hour dial, casting a long shadow on pale stone." width="1536" height="1024" fetchpriority="high" decoding="async" />
      <div class="scene-shade" aria-hidden="true"></div>
    </div>
    <header class="header page-width">
      <a class="wordmark" href="#main" aria-label="Hora Capital">
        <img src="/images/hora-capital/mark.svg" alt="" width="38" height="38" />
        <span>hora<span class="wordmark-sub">capital</span></span>
      </a>
      <a class="contact-link" href={"mailto:" + site.email}>Get in touch <ArrowUpRight size={16} aria-hidden="true" /></a>
    </header>
    <main id="main" class="page-width" tabindex="-1">
      <div class="hero-copy">
        <h1>Capital that<br />gives you <em>time.</em></h1>
        <div class="mission">
          <h2>Our purpose</h2>
          <p>{mission}</p>
        </div>
      </div>
    </main>
    <footer class="footer page-width">
      <span>Hora Capital</span>
      <a href={"mailto:" + site.email}>{site.email}<ArrowUpRight size={16} aria-hidden="true" /></a>
    </footer>
  </body>
</html>
