---
import type { PostMeta } from "../lib/content";
import { seriesRegistry } from "../lib/site";
import PostMetaView from "./PostMeta.astro";

interface Props {
  post: PostMeta;
}

const { post } = Astro.props;
const series = post.series ? seriesRegistry[post.series] : undefined;
---

<article class='group flex h-full flex-col'>
  <a href={post.routePath} class='no-rule block overflow-hidden rounded-[18px] bg-surface'>
    <div class='aspect-[5/4] overflow-hidden'>
      <img
        src={post.coverImage}
        alt={post.title}
        loading='lazy'
        onerror="this.onerror=null;this.src='/images/posts/default-cover.svg';"
        class='h-full w-full object-cover transition duration-700 ease-out group-hover:scale-[1.04]'
      />
    </div>
  </a>

  <div class='mt-4 flex flex-1 flex-col'>
    {series && (
      <a
        href={`/blog?series=${post.series}`}
        class='no-rule mb-2 inline-flex w-fit items-center rounded-full bg-ink px-2.5 py-1 font-mono text-[0.64rem] font-bold uppercase tracking-[0.12em] text-paper transition hover:bg-terracotta'
      >
        {series.label}
      </a>
    )}
    <PostMetaView post={post} />
    <h2
      class='mt-2 font-display leading-[1.08] tracking-[-0.025em] text-ink'
      style='font-size: clamp(1.3rem, 1.9vw, 1.6rem); font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 72; font-weight: 700;'
    >
      <a href={post.routePath} class='no-rule text-ink transition group-hover:text-terracotta'>
        {post.title}
      </a>
    </h2>
    <p class='mt-2 text-[1.02rem] leading-relaxed text-ink-soft'>
      {post.summary}
    </p>
  </div>
</article>
